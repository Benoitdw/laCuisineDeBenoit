---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableauPain from '../../components/TableauPain.svelte';
import { getCollection } from 'astro:content';

const pains = await getCollection('pain');
const tries = pains.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const serialises = tries.map(p => ({
  id: p.id,
  data: {
    ...p.data,
    date: p.data.date.toISOString(),
  },
}));
---

<BaseLayout
  title="Pain"
  description="Journal de boulangerie — paramètres, notes et avis sur chaque fournée."
>
  <div class="pain-hero">
    <div class="hero-ornament" aria-hidden="true">
      <svg width="220" height="220" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width=".4">
        <line x1="2" y1="13" x2="14" y2="13"/>
        <path d="M2 13 Q2 4 8 3 Q14 4 14 13"/>
        <path d="M5 8 Q8 6.5 11 8" stroke-width=".35"/>
      </svg>
    </div>
    <div class="pain-hero-inner">
      <div class="hero-rule"></div>
      <h1>Journal Pain</h1>
      <p class="pain-intro">
        Chaque entrée consigne les paramètres d'une fournée : farines, hydratation, sel, levure — et une note honnête.
      </p>
    </div>
  </div>

  <div class="content">
    <details class="protocole">
      <summary>
        <span class="protocole-titre">Protocole de base</span>
        <span class="protocole-hint">Autolyse · Pointage · Façonnage · Cuisson </span>
      </summary>
      <div class="protocole-body">
        <div class="protocole-item protocole-chrono">
          <a href="chrono/" class="chrono-cta">
            <svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width=".9" aria-hidden="true">
              <circle cx="8" cy="8" r="5.5"/>
              <line x1="8" y1="8" x2="8" y2="4.5"/>
              <line x1="8" y1="8" x2="10.5" y2="9.5"/>
            </svg>
            Lancer le Chrono Pain
          </a>
          <p class="chrono-desc">Minuteur pas à pas pour guider chaque étape de la fournée.</p>
        </div>
        <div class="protocole-item">
          <h3>Autolyse</h3>
          <p>Mélanger farine + eau, repos 30–60 min avant d'ajouter levain/levure et sel. Facilite le développement du gluten.</p>
        </div>
        <div class="protocole-item">
          <h3>Pointage &amp; rabats</h3>
          <p>1h30–2h30 h à 24 °C avec 2 séries de rabats.Tu pe La pâte doit doubler.</p>
        </div>
        <div class="protocole-item">
          <h3>Façonnage &amp; apprêt</h3>
          <p>Façonner en boule ou bâtard. Apprêt 1 h à TA ou une nuit au frigo (4 °C) pour plus de saveur.</p>
        </div>
        <div class="protocole-item">
          <h3>Cuisson</h3>
          <p>Four à 250 °C avec cocotte préchauffée. 20 min couvert, 20–25 min découvert jusqu'à croûte dorée foncée.</p>
        </div>
      </div>
    </details>

    <TableauPain client:load pains={serialises} />
  </div>
</BaseLayout>

<style>
  .pain-hero {
    background: var(--forest);
    padding: 3rem 2rem 2.5rem;
    border-bottom: 3px solid var(--copper);
    position: relative;
    overflow: hidden;
  }
  .hero-ornament {
    position: absolute;
    right: 3rem;
    top: 50%;
    transform: translateY(-50%);
    opacity: .07;
    pointer-events: none;
    color: var(--paper);
  }
  .pain-hero-inner {
    max-width: 960px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }
  .hero-rule { width: 40px; height: 2px; background: var(--copper); margin-bottom: 1rem; }
  h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 700;
    color: var(--paper);
    margin-bottom: .7rem;
  }
  .pain-intro {
    font-style: italic;
    color: rgba(245,237,216,.6);
    font-size: .95rem;
    max-width: 480px;
    line-height: 1.7;
  }
  .content {
    max-width: 960px;
    margin: 0 auto;
    padding: 2rem 2rem 4rem;
  }

  /* Protocole de base */
  .protocole {
    border-left: 3px solid var(--copper);
    background: rgba(184,115,51,.04);
    border-radius: 0 3px 3px 0;
    margin-bottom: 2.5rem;
  }

  .protocole summary {
    cursor: pointer;
    padding: .9rem 1.25rem;
    display: flex;
    align-items: baseline;
    gap: 1rem;
    list-style: none;
    user-select: none;
  }
  .protocole summary::-webkit-details-marker { display: none; }

  .protocole[open] summary {
    border-bottom: 1px solid rgba(184,115,51,.2);
  }

  .protocole-titre {
    font-family: 'Playfair Display', serif;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--forest);
  }

  .protocole-hint {
    font-size: .78rem;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--copper);
    font-family: 'Lora', serif;
  }

  .protocole-body {
    padding: 1rem 1.25rem 1.25rem;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1rem 1.5rem;
  }

  .protocole-chrono {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: .4rem;
    border-right: 1px solid rgba(184,115,51,.15);
  }

  .chrono-cta {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    font-family: 'Playfair Display', serif;
    font-size: .9rem;
    font-weight: 700;
    color: var(--forest);
    text-decoration: none;
    transition: color .15s;
  }
  .chrono-cta:hover { color: var(--copper); }

  .chrono-desc {
    font-family: 'Lora', serif;
    font-size: .82rem;
    line-height: 1.5;
    color: var(--muted);
    font-style: italic;
  }

  .protocole-item h3 {
    font-family: 'Playfair Display', serif;
    font-size: .85rem;
    font-weight: 700;
    color: var(--copper);
    margin-bottom: .3rem;
    letter-spacing: .03em;
  }

  .protocole-item p {
    font-family: 'Lora', serif;
    font-size: .85rem;
    line-height: 1.6;
    color: var(--ink);
  }
</style>
