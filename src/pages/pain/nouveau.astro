---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormulairePain from '../../components/FormulairePain.svelte';

// Charger les presets disponibles pour le select
const modules = import.meta.glob<{ id: string; label: string }>('../../data/presets/*.json', {
  eager: true,
  import: 'default',
});
const presets = Object.values(modules).map(p => ({ id: p.id, label: p.label }));
---

<BaseLayout
  title="Nouvelle fournée"
  description="Enregistrer et proposer une nouvelle fournée de pain."
>

  <div class="form-hero">
    <div class="hero-ornament" aria-hidden="true">
      <svg width="180" height="180" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width=".4">
        <line x1="2" y1="13" x2="14" y2="13"/>
        <path d="M2 13 Q2 4 8 3 Q14 4 14 13"/>
        <path d="M5 8 Q8 6.5 11 8" stroke-width=".35"/>
      </svg>
    </div>
    <div class="hero-inner">
      <h1>Nouvelle fournée</h1>
      <p class="hero-intro">
        Renseignez les paramètres de la fournée, vérifiez l'aperçu YAML, puis cliquez sur
        <em>Proposer sur GitHub</em> pour créer le fichier directement.
      </p>
      <div class="hero-links">
        <a href="../" class="hero-back">← Journal Pain</a>
        <a href="../chrono/" class="hero-back">⏱ Levainier</a>
      </div>
    </div>
  </div>

  <div class="content">
    <FormulairePain client:load {presets} />
  </div>

</BaseLayout>

<style>
  .form-hero {
    background: var(--forest);
    padding: 1.75rem 2rem 1.5rem;
    border-bottom: 3px solid var(--copper);
    position: relative;
    overflow: hidden;
  }

  .hero-ornament {
    position: absolute;
    right: 3rem;
    top: 50%;
    transform: translateY(-50%);
    opacity: .08;
    pointer-events: none;
    color: var(--paper);
  }

  .hero-inner {
    max-width: 820px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    font-weight: 700;
    color: var(--paper);
    margin: 0 0 .4rem;
  }

  .hero-intro {
    font-style: italic;
    color: rgba(245,237,216,.55);
    font-size: .88rem;
    max-width: 520px;
    line-height: 1.6;
    margin: 0;
  }

  .hero-links {
    display: flex;
    gap: 1.5rem;
    margin-top: .7rem;
  }

  .hero-back {
    font-family: 'Lora', serif;
    font-size: .78rem;
    color: rgba(245,237,216,.45);
    text-decoration: none;
    letter-spacing: .04em;
    transition: color .15s;
  }
  .hero-back:hover { color: var(--copper-lt); }

  .content {
    max-width: 820px;
    margin: 0 auto;
    padding: 2rem 2rem 4rem;
  }
</style>
