---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ChronoPain from '../../../components/ChronoPain.svelte';
---

<BaseLayout
  title="Levainier"
  description="Minuteur pas à pas pour la boulangerie maison — pétrissage, pointage, apprêt, cuisson."
>
  <div class="chrono-hero">
    <div class="hero-ornament" aria-hidden="true">
      <svg width="180" height="180" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width=".4">
        <circle cx="8" cy="8" r="5.5"/>
        <line x1="8" y1="8" x2="8" y2="4"/>
        <line x1="8" y1="8" x2="11" y2="9.5"/>
        <line x1="8" y1="2.5" x2="8" y2="2"/>
        <line x1="8" y1="14" x2="8" y2="13.5"/>
        <line x1="2.5" y1="8" x2="2" y2="8"/>
        <line x1="14" y1="8" x2="13.5" y2="8"/>
      </svg>
    </div>
    <div class="hero-inner">
      <h1>Levainier</h1>
      <p class="hero-intro">
        Configurez votre process, démarrez le minuteur, et suivez chaque étape de la fournée.
      </p>
      <div class="hero-links">
        <a href="../" class="hero-back">← Journal pain</a>
        <a href="aide/" class="hero-back">? Aide</a>
      </div>
    </div>
  </div>

  <div class="content">
    <ChronoPain client:load />
  </div>
</BaseLayout>

<style>
  .chrono-hero {
    background: var(--forest);
    padding: 1.75rem 2rem 1.5rem;
    border-bottom: 3px solid var(--copper);
    position: relative;
    overflow: hidden;
  }

  .hero-ornament {
    position: absolute;
    right: 3rem;
    top: 50%;
    transform: translateY(-50%);
    opacity: .08;
    pointer-events: none;
    color: var(--paper);
  }

  .hero-inner {
    max-width: 820px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    font-weight: 700;
    color: var(--paper);
    margin: 0 0 .4rem;
  }

  .hero-intro {
    font-style: italic;
    color: rgba(245,237,216,.55);
    font-size: .88rem;
    max-width: 480px;
    line-height: 1.6;
    margin: 0;
  }

  .hero-links {
    display: flex;
    gap: 1.5rem;
    margin-top: .7rem;
  }

  .hero-back {
    font-family: 'Lora', serif;
    font-size: .78rem;
    color: rgba(245,237,216,.45);
    text-decoration: none;
    letter-spacing: .04em;
    transition: color .15s;
  }
  .hero-back:hover { color: var(--copper-lt); }

  .content {
    max-width: 820px;
    margin: 0 auto;
    padding: 2rem 2rem 4rem;
  }
</style>
