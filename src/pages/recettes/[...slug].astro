---
import { getCollection, render } from 'astro:content';
import RecetteLayout from '../../layouts/RecetteLayout.astro';

export async function getStaticPaths() {
  const toutes = await getCollection('recettes');
  const courantes = toutes.filter(r => !r.data.archive_de);
  return courantes.map(r => {
    const slug = r.id.replace(/\/index\.md$/, '').replace(/\.md$/, '');
    const archives = toutes.filter(a => a.data.archive_de === slug);
    return {
      params: { slug },
      props: { recette: r, archives },
    };
  });
}

const { recette, archives } = Astro.props;
const { Content } = await render(recette);
const slug = recette.id.replace(/\/index\.md$/, '').replace(/\.md$/, '');
---

<RecetteLayout recette={recette} archives={archives} giscusTerm={slug}>
  <Content />
</RecetteLayout>
