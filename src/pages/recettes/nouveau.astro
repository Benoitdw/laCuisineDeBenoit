---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormulaireRecette from '../../components/FormulaireRecette.svelte';
---

<BaseLayout
  title="Nouvelle recette"
  description="Créer et proposer une nouvelle recette pour La cuisine de Benoît."
>

  <div class="form-hero">
    <div class="hero-inner">
      <h1>Nouvelle recette</h1>
      <p class="hero-intro">
        Remplissez le formulaire, vérifiez l'aperçu YAML, puis cliquez sur
        <em>Proposer sur GitHub</em> pour ouvrir directement l'interface de création de fichier.
      </p>
      <a href="../" class="hero-back">← Recettes</a>
    </div>
  </div>

  <div class="content">
    <FormulaireRecette client:load />
  </div>

</BaseLayout>

<style>
  .form-hero {
    background: var(--forest);
    padding: 1.75rem 2rem 1.5rem;
    border-bottom: 3px solid var(--copper);
    position: relative;
    overflow: hidden;
  }

  .hero-inner {
    max-width: 820px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    font-weight: 700;
    color: var(--paper);
    margin: 0 0 .4rem;
  }

  .hero-intro {
    font-style: italic;
    color: rgba(245,237,216,.55);
    font-size: .88rem;
    max-width: 520px;
    line-height: 1.6;
    margin: 0;
  }

  .hero-back {
    display: inline-block;
    margin-top: .7rem;
    font-family: 'Lora', serif;
    font-size: .78rem;
    color: rgba(245,237,216,.45);
    text-decoration: none;
    letter-spacing: .04em;
    transition: color .15s;
  }
  .hero-back:hover { color: var(--copper-lt); }

  .content {
    max-width: 820px;
    margin: 0 auto;
    padding: 2rem 2rem 4rem;
  }
</style>
