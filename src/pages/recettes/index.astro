---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FiltreRecettes from '../../components/FiltreRecettes.svelte';
import { getCollection } from 'astro:content';

const recettes = await getCollection('recettes');
const courantes = recettes.filter(r => !r.data.archive_de);
const triees = courantes.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const serialisees = triees.map(r => ({
  slug: r.id.replace(/\/index\.md$/, '').replace(/\.md$/, ''),
  data: {
    ...r.data,
    date: r.data.date.toISOString(),
    // Préfixer le base URL pour que Svelte puisse utiliser l'image directement
    image: r.data.image ? `${base}${r.data.image}` : undefined,
  },
}));
---

<BaseLayout
  title="Recettes"
  description="Recettes de cuisine simples et savoureuses — du quotidien à l'occasion spéciale."
>

  <!-- HERO -->
  <div class="hero">
    <div class="hero-ornament" aria-hidden="true">
      <svg width="200" height="200" viewBox="0 0 16 16" fill="none" stroke="#F5EDD8" stroke-linecap="round" stroke-linejoin="round" stroke-width=".4">
        <path d="M6 5 Q5 8 6 11 Q8 15 9 13 Q11 9 10 5Z"/>
        <path d="M8 5 C8 3 6 1 5 1"/>
        <path d="M8 5 C8 2 9 1 10 0"/>
        <path d="M8 5 C7 3 7 1 8 0"/>
        <line x1="7" y1="7" x2="9.5" y2="6.5" stroke-width=".3" opacity=".6"/>
        <line x1="6.5" y1="9.5" x2="9.5" y2="9" stroke-width=".3" opacity=".6"/>
      </svg>
    </div>
    <div class="hero-inner">
      <h1>Recettes</h1>
      <p class="hero-intro">
        Bienvenue dans ma cuisine, ici on y trouve des recettes simples, de saison, testées et parfois à améliorer. Pas de rigidité dans les recettes la plupart des ingrédients sont interchangeable
        et sont à adapter avec ce que vous avez sous la main.
      </p>
      <div class="hero-links">
        <a href="nouveau/" class="hero-link-new">+ Nouvelle recette</a>
      </div>
    </div>
  </div>

  <!-- RECETTES + FILTRES -->
  <div class="content">
    <FiltreRecettes
      client:load
      recettes={serialisees}
      base={base}
    />
  </div>

</BaseLayout>

<style>
  .hero {
    background: var(--forest);
    padding: 1.75rem 2rem 1.5rem;
    position: relative;
    overflow: hidden;
    border-bottom: 3px solid var(--copper);
  }
  .hero-ornament {
    position: absolute;
    right: 3rem;
    top: 50%;
    transform: translateY(-50%);
    opacity: .08;
    pointer-events: none;
  }
  .hero-inner {
    max-width: 820px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }
  h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    font-weight: 700;
    color: var(--paper);
    line-height: 1.12;
    margin: 0 0 .4rem;
  }
  .hero-intro {
    font-style: italic;
    color: rgba(245,237,216,.55);
    font-size: .88rem;
    max-width: 500px;
    line-height: 1.65;
  }
  .hero-links {
    margin-top: .7rem;
  }
  .hero-link-new {
    font-family: 'Lora', serif;
    font-size: .78rem;
    color: rgba(245,237,216,.45);
    text-decoration: none;
    letter-spacing: .04em;
    transition: color .15s;
  }
  .hero-link-new:hover { color: var(--copper-lt); }

  .content {
    max-width: 820px;
    margin: 0 auto;
    padding: 2rem 2rem 4rem;
  }
</style>
