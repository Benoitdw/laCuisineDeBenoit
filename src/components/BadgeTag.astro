---
interface Props {
  tag: string;
  href?: string;
}
const { tag, href } = Astro.props;
---

{href ? (
  <a
    href={href}
    class="inline-block px-2 py-0.5 bg-amber-50 text-amber-700 border border-amber-200 rounded-full text-xs hover:bg-amber-100 transition-colors"
  >
    {tag}
  </a>
) : (
  <span class="inline-block px-2 py-0.5 bg-amber-50 text-amber-700 border border-amber-200 rounded-full text-xs">
    {tag}
  </span>
)}
