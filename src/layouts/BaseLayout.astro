---
import '../styles/global.css';
import Logo from '../components/Logo.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const {
  title,
  description = 'Blog de recettes de cuisine par Benoît — des recettes simples, savoureuses et testées.',
  image,
  type = 'website',
} = Astro.props;

const siteUrl = import.meta.env.SITE || 'https://bdewitte.github.io';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);
const pathname = Astro.url.pathname;
const isHome = pathname === base + '/' || pathname === base || pathname === '/';
const isRecettes = pathname.startsWith(base + '/recettes') || pathname.startsWith('/recettes');
const isPain = pathname.startsWith(base + '/pain') || pathname.startsWith('/pain');
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />

    <title>{title} — La cuisine de Benoît</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={`${title} — La cuisine de Benoît`} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="La Cuisine de Benoît" />
    {image && <meta property="og:image" content={new URL(image, siteUrl)} />}

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,700&family=Lora:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet" />
  </head>
  <body>

    <header class="print:hidden">
      <nav>
        <a href={`${base}/`} class="logo">
          <Logo size={30} variant="dark" />
          <div>
            <span class="logo-text">La cuisine de Benoît</span>
            <span class="logo-sub">recettes de saison</span>
          </div>
        </a>
        <ul class="nav-links">
          <li><a href={`${base}/`} class:list={[{ active: isHome }]}>Accueil</a></li>
          <li><a href={`${base}/recettes/`} class:list={[{ active: isRecettes }]}>Recettes</a></li>
          <li><a href={`${base}/pain/`} class:list={[{ active: isPain }]}>Pain</a></li>
        </ul>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="print:hidden">
      <p>© {new Date().getFullYear()} La cuisine de Benoît</p>
    </footer>

  </body>
</html>

<style is:global>
  nav {
    background: var(--forest);
    padding: 1rem 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 2px solid var(--copper);
  }
  .logo {
    display: flex;
    align-items: center;
    gap: .7rem;
    text-decoration: none;
  }
  .logo-text {
    font-family: 'Playfair Display', serif;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--copper-lt);
    letter-spacing: .03em;
    display: block;
  }
  .logo-sub {
    display: block;
    font-size: .62rem;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: rgba(255,255,255,.32);
    margin-top: -.1rem;
  }
  .nav-links {
    display: flex;
    gap: 1.5rem;
    list-style: none;
  }
  .nav-links a {
    font-size: .85rem;
    color: rgba(255,255,255,.6);
    text-decoration: none;
    letter-spacing: .06em;
    text-transform: uppercase;
    padding-bottom: .15rem;
    border-bottom: 2px solid transparent;
    transition: color .15s, border-color .15s;
  }
  .nav-links a:hover { color: var(--copper-lt); }
  .nav-links a.active {
    color: var(--copper-lt);
    border-bottom-color: var(--copper-lt);
  }

  footer {
    background: var(--forest);
    color: rgba(245,237,216,.3);
    text-align: center;
    padding: 1.25rem;
    font-size: .7rem;
    letter-spacing: .06em;
    text-transform: uppercase;
    margin-top: 4rem;
  }
</style>
